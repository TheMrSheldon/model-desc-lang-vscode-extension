{
  "name": "mdl-language-server",
  "displayName": "mdl-language-server",
  "description": "Language server for the model description language (mdl)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/client.js",
  "contributes": {
    "languages": [
      {
        "id": "model-desc-lang",
        "extensions": [
          ".dlm"
        ],
        "configuration": "./src/syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "model-desc-lang",
        "scopeName": "source.model-desc-lang",
        "path": "./src/syntaxes/model-desc-lang.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mdl.restartServer",
        "title": "MDL: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Model Description Language",
      "properties": {
        "mdl.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `mdls` executable. Empty: use an `mdls` from the `PATH` (a local MDL installation), else the one bundled with the extension."
        },
        "mdl.importDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional directories that are searched for imported files."
        },
        "mdl.float": {
          "type": "string",
          "enum": [
            "f32",
            "bf16",
            "f16"
          ],
          "default": "f32",
          "description": "The type that `float` stands for."
        },
        "mdl.server.preferBundled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use the `mdls` bundled with the extension even if there is one on the `PATH`. Ignored if `mdl.server.path` is set."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "axis",
        "superType": "typeParameter",
        "description": "An axis name in an einops pattern"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "fetch-server": "node scripts/fetch-server.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "mathjax-full": "3.2.2",
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMrSheldon/model-desc-lang-vscode-extension.git"
  }
}
